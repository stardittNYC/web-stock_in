# ============================================================
#  Laravel 12 — .gitignore
#
#  Isi folder runtime (storage/*, bootstrap/cache, public/uploads,
#  database/*.sqlite) di-ignore lewat file .gitignore DI DALAM
#  masing-masing folder, supaya struktur foldernya tetap ikut
#  ke-track saat di-clone.
# ============================================================

# ---- Dependencies ----
/vendor/
/node_modules/

# ---- Environment & secrets ----
.env
.env.*
!.env.example
/auth.json
/storage/*.key

# ---- Build output & generated assets ----
/public/build/
/public/hot
/public/storage

# ---- Logs ----
*.log

# ---- Testing ----
/.phpunit.cache/
.phpunit.result.cache

# ---- OS & editor ----
.DS_Store
Thumbs.db
/.idea/
/.vscode/
/.fleet/
/.nova/
/.zed/

# ---- AI assistant tooling ----
.claude/
.commandcode/
